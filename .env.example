# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-replace-me

# Per-agent model selection. Triage is cheap on purpose.
TRIAGE_MODEL=gpt-4o-mini
KNOWLEDGE_MODEL=gpt-4o-mini
ACCOUNT_MODEL=gpt-4o-mini
RESOLVER_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o-mini

# Budget ceilings enforced across a whole ticket, not per call.
MAX_COST_PER_TICKET_USD=0.05
MAX_TOKENS_PER_TICKET=40000

# Phase 7
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
