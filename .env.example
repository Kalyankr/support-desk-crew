# Copy to .env and fill in. Never commit .env.
# OpenRouter: https://openrouter.ai/keys — one key, routes to any provider's models.
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-agent model selection, as OpenRouter "provider/model" ids. Triage is cheap on purpose.
TRIAGE_MODEL=openai/gpt-4o-mini
KNOWLEDGE_MODEL=openai/gpt-4o-mini
ACCOUNT_MODEL=openai/gpt-4o-mini
RESOLVER_MODEL=openai/gpt-4o
CRITIC_MODEL=openai/gpt-4o-mini

# Budget ceilings enforced across a whole ticket, not per call.
MAX_COST_PER_TICKET_USD=0.05
MAX_TOKENS_PER_TICKET=40000

# Phase 7
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
